{
  "name": "campus-marketplace",
  "version": "1.0.0",
  "private": true,
  "description": "Campus Marketplace Monorepo - Student Second-hand Trading Platform",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev": "pnpm --parallel --filter \"@campus/*\" dev",
    "build": "pnpm --filter \"@campus/*\" run build",
    "lint": "pnpm --filter \"@campus/*\" run lint",
    "typecheck": "pnpm --filter \"@campus/*\" run typecheck",
    "test": "pnpm --filter \"@campus/*\" run test",
    "test:unit": "pnpm --filter @campus/backend run test",
    "test:frontend": "pnpm --filter @campus/frontend run test",
    "test:e2e": "pnpm --filter @campus/backend run test:e2e",
    "db:test": "pnpm --filter @campus/backend db:test",
    "db:migrate": "pnpm --filter @campus/backend db:migrate",
    "db:verify": "pnpm --filter @campus/backend db:verify",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yaml,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}

