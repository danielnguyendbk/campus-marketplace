# Campus Marketplace Monorepo Root Environment Example
# Copy this file to .env or configure in respective apps

NODE_ENV=development

# Backend Configuration
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Supabase / PostgreSQL Database Connection (SQL-First pg pool)
# Note: For local development / health check, backend will start gracefully even if DB is not connected.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# TLS / SSL Security Configuration (Condition 5 / AUDIT-04)
# Remote connections (Supabase, AWS RDS, etc.) enforce TLS certificate verification by default.
# rejectUnauthorized defaults to true (never defaults to false in any environment).
# To provide custom CA certificates (such as Supabase Root 2021 CA):
# PGSSL_CA_PATH=./database/supabase-ca.crt
# PGSSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PGSSL_REJECT_UNAUTHORIZED=true

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
