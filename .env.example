# Campus Marketplace Monorepo Root Environment Example
# Copy this file to .env or configure in respective apps

NODE_ENV=development

# Backend Configuration
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Supabase / PostgreSQL Database Connection (SQL-First pg pool)
# Note: For local development / health check, backend will start gracefully even if DB is not connected.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@[YOUR-SUPABASE-HOST]:5432/postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=postgres

# TLS / SSL Security Configuration (Condition 5 / AUDIT-04)
# Remote connections (Supabase, AWS RDS, etc.) enforce TLS certificate verification by default.
# rejectUnauthorized defaults to true (never defaults to false in any environment).
# To provide custom CA certificates (such as Supabase Root 2021 CA):
# PGSSL_CA_PATH=./database/supabase-ca.crt
# PGSSL_CA="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# PGSSL_REJECT_UNAUTHORIZED=true

# Authentication, OTP & JWT Configuration (CMP-6 / FR-01)
# Secrets MUST be at least 32 characters in production.
JWT_SECRET=replace-with-random-secret-at-least-32-chars
JWT_EXPIRES_IN=3600
OTP_HASH_SECRET=replace-with-random-otp-hmac-secret-32-chars
OTP_TICKET_SECRET=replace-with-random-otp-ticket-secret-32-chars
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
ALLOWED_SCHOOL_DOMAINS=edu.vn
BCRYPT_SALT_ROUNDS=12

# University OTP Mail Dispatcher (console in dev/test, smtp in production)
MAIL_TRANSPORT=console
MAIL_FROM="Campus Marketplace <no-reply@campus-marketplace.local>"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:3000/api/v1
